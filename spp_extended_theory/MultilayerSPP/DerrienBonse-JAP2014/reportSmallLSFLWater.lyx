\begin_layout Subsection
Free carrier density of Si in air and water
\end_layout

\begin_layout Standard
Now we have calculated possible periodicities at the interfaces present
 in the system, and considered the possible interactions together, we calculate
 the densities that the laser can excite in either Si, in air and in water
 medium.
 
\end_layout

\begin_layout Paragraph
Model for Si
\end_layout

\begin_layout Standard
For Si, we calculate the number of carriers excited in the conduction band.
 Calculations were performed for interaction in air and in water environments.
 
\end_layout

\begin_layout Standard
Free-carrier density 
\begin_inset Formula $N_{e}$
\end_inset

 is calculated considering photonic transitions by solving Eq.
 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:NeAnalytic"

\end_inset

 
\begin_inset Formula 
\begin{equation}
\frac{\partial N_{e}}{\partial t}=\frac{\sigma_{1}I}{\hbar\omega}+\frac{\sigma_{2}I^{2}}{2\hbar\omega}\label{eq:NeAnalytic}
\end{equation}

\end_inset

where laser intensity at the surface is given by Eq.
 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:Intensity"

\end_inset

 
\begin_inset Formula 
\begin{equation}
I(t)_{z=0}=(1-R)\times\frac{F}{\tau}\sqrt{\frac{4\ln2}{\pi}}\times e^{-\frac{1}{2}\left(\frac{t}{\sigma_{\tau}}\right)^{2}}\label{eq:Intensity}
\end{equation}

\end_inset

where 
\begin_inset Formula $\sigma_{\tau}=\frac{\tau}{2\sqrt{2\ln2}}$
\end_inset

.
 
\end_layout

\begin_layout Standard
The calculations have been performed for the following cases: (i) by solving
 Eq.
 (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:NeAnalytic"

\end_inset

, 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:Intensity"

\end_inset

) and taking 
\begin_inset Formula $R$
\end_inset

 as constant; (b) by using the model of Ref.
 
\begin_inset CommandInset citation
LatexCommand citep
key "Derrien2013a"

\end_inset

 accounting for the contribution to the whole sample to the surface reflectivity.
 
\end_layout

\begin_layout Paragraph
Model for water
\end_layout

\begin_layout Standard
For water, quantity of free-carriers in water is calculated by using the
 model of 
\begin_inset CommandInset citation
LatexCommand citet
key "Noack1999"

\end_inset

, where multiphotonic excitation of water (Keldysh model), cascade ionization
 and recombination of free-carriers with water molecules have been taken
 into account.
 
\begin_inset Formula 
\begin{equation}
\frac{\partial N_{e}^{H_{2}O}}{\partial t}=w_{MPI}(t)+\eta_{casc}N_{e}^{H_{2}O}\label{eq:NeH2O}
\end{equation}

\end_inset

where 
\begin_inset Formula 
\[
w_{MPI}(t)=\frac{2\omega}{9\pi}\left(\frac{m\omega}{2\hbar}\right)^{3/2}\left(\frac{2e^{2}I_{abs}(t)}{16m_{e}E_{g}\omega^{2}c\varepsilon_{0}n}\right)^{k}e^{2k}\phi\left(\sqrt{2k-\frac{2E_{g}}{\hbar\omega}}\right)
\]

\end_inset

 and 
\begin_inset Formula $\phi(x)=e^{-x^{2}}\int_{0}^{x}e^{y^{2}}dy$
\end_inset

.
 
\begin_inset Formula $k$
\end_inset

 is the number of photons involved in the transition 
\begin_inset Formula 
\[
k=E\left(\frac{E_{gap}}{\hbar\omega}+1\right)
\]

\end_inset

 and 
\begin_inset Formula $I_{abs}(t)=\left(1-R_{interface}\right)I_{0}\sqrt{\frac{4\ln2}{\pi}}e^{-4\ln2\left(\frac{t}{\tau}\right)^{2}}$
\end_inset

, where reflectivity at the 
\begin_inset Formula $air-SiO_{2}-water$
\end_inset

 interface is 
\begin_inset Formula $R_{interface}=3.17\%$
\end_inset

.
 In this section, solution of Eq.
 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:NeH2O"

\end_inset

 has been calculated analytically, following the parameters given by 
\begin_inset CommandInset citation
LatexCommand citet
key "Noack1999"

\end_inset

.
 
\end_layout

