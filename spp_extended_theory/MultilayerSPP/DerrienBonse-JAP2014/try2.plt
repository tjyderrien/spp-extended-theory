# palette for great pictures
# Check website for wonderful colormaps
# Colorbrewer2.org

set style line 1 linecolor rgb '#A6CEE3' lw 3
set style line 2 linecolor rgb '#1F78B4' lw 3
set style line 3 linecolor rgb '#B2DF8A' lw 3
set style line 4 linecolor rgb '#33A02C' lw 3
set style line 5 linecolor rgb '#FB9A99' lw 3
set style line 6 linecolor rgb '#E31A1C' lw 3

set palette defined (\
0 '#A6CEE3', \
1 '#1F78B4', \
2 '#B2DF8A', \
3 '#33A02C', \
4 '#FB9A99', \
5 '#E31A1C')
