\begin_layout Section
SPP excitation at a single interface
\end_layout

\begin_layout Standard
Condition for SPP excitation at a single interface between media 
\begin_inset Formula $1$
\end_inset

 and 
\begin_inset Formula $2$
\end_inset

 is given by 
\begin_inset Formula 
\begin{equation}
f(\varepsilon_{1},\varepsilon_{2})<0\label{eq:ConditionSPP}
\end{equation}

\end_inset

where 
\begin_inset Formula 
\[
f(\varepsilon_{1},\varepsilon_{2})=\Re e\left(\varepsilon_{1}\right)\Re e\left(\varepsilon_{2}\right)+\Im m\left(\varepsilon_{1}\right)\Im m\left(\varepsilon_{2}\right)
\]

\end_inset

.
 
\end_layout

