\begin_layout Subsubsection
Periodicity of SPPs at single interface
\end_layout

\begin_layout Standard
Periodicity of the SPPs at a single interface is given by 
\begin_inset Formula $\Lambda=\frac{2\pi}{\Re e\left(\beta\right)}$
\end_inset

 
\begin_inset CommandInset citation
LatexCommand citep
key "Raether1986,Zayats2005,Maier2007"

\end_inset

 where 
\begin_inset Formula 
\begin{equation}
\beta=\frac{\omega}{c}\sqrt{\frac{\varepsilon_{1}\varepsilon_{2}}{\varepsilon_{1}+\varepsilon_{2}}}.\label{eq:SimpleSPP}
\end{equation}

\end_inset

This relation is valid at any interface but must be restricted by condition
 by Eq.
 
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:ConditionSPP"

\end_inset

.
 
\end_layout

\begin_layout Subsection
Multilayer SPP model
\end_layout

\begin_layout Standard
Dispersion relation describing the electric and magnetic fields in the Transvers
e Magnetic direction, in a multilayer system is given by 
\begin_inset CommandInset citation
LatexCommand citep
key "Prade1991,Maier2007"

\end_inset

 
\begin_inset Formula 
\begin{equation}
e^{-2k_{1}t}=\frac{\frac{k_{1}}{\varepsilon_{1}}+\frac{k_{2}}{\varepsilon_{2}}}{\frac{k_{1}}{\varepsilon_{1}}-\frac{k_{2}}{\varepsilon_{2}}}\times\frac{\frac{k_{1}}{\varepsilon_{1}}+\frac{k_{3}}{\varepsilon_{3}}}{\frac{k_{1}}{\varepsilon_{1}}-\frac{k_{3}}{\varepsilon_{3}}}\label{eq:ImplicitEq}
\end{equation}

\end_inset

where 
\begin_inset Formula 
\begin{equation}
k_{i}^{2}=\beta^{2}-k_{0}^{2}\varepsilon_{i}\label{eq:WaveVectors}
\end{equation}

\end_inset


